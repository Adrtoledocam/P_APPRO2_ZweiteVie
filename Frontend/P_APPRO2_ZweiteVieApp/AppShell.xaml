<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="P_APPRO2_ZweiteVieApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:P_APPRO2_ZweiteVieApp.Views"
    xmlns:root="clr-namespace:P_APPRO2_ZweiteVieApp"
    Title="P_APPRO2_ZweiteVieApp">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        Shell.NavBarIsVisible="False"/>
    <TabBar>
        <Tab Title="Catalogue" Icon="icon_catalog.svg">
            <ShellContent ContentTemplate="{DataTemplate root:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Favoris" Icon="icon_favorites.svg">
            <ShellContent ContentTemplate="{DataTemplate views:FavoritesPage}" Route="FavoritesPage" />
        </Tab>
        <Tab Title="Publication" Icon="icon_add.svg">
            <ShellContent ContentTemplate="{DataTemplate views:AddPublicationPage}" Route="AddPublicationPage" />
        </Tab>
        <Tab Title="Profil" Icon="icon_profile.svg">
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" Route="ProfilePage" />
        </Tab>
    </TabBar>

</Shell>
