<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P_APPRO2_ZweiteVieApp.Views.RegisterPage"
             Title="Nouveau compte">
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label Text="Créer un compte" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

        <Entry Placeholder="Nom d'utilisateur" Text="{Binding Username}" />
        <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
        <Entry Placeholder="Mot de passe" Text="{Binding Password}" IsPassword="True" />

        <Button Text="Créer un nouveau compte" 
                Command="{Binding RegisterCommand}" 
                BackgroundColor="#008F39" 
                TextColor="White" />

        <Button Text="Retour au login" 
                Clicked="OnBackClicked"
                BackgroundColor="Transparent" 
                TextColor="Gray" />
    </VerticalStackLayout>
</ContentPage>