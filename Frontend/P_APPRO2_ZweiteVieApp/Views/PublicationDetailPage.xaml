<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:P_APPRO2_ZweiteVieApp.ViewModels"
             x:Class="P_APPRO2_ZweiteVieApp.Views.PublicationDetailPage"
             Title="Détails">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Image Source="{Binding SelectedPublication.PubImage}" 
                   HeightRequest="300" 
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"/>

            <VerticalStackLayout Padding="20" Spacing="15">
                <Label Text="{Binding SelectedPublication.PubTitle}" FontSize="24" FontAttributes="Bold" />
                <Label Text="{Binding SelectedPublication.CatName}" FontSize="16" TextColor="#008F39" />

                <HorizontalStackLayout Spacing="20">
                    <Label Text="État :" FontAttributes="Bold" />
                    <Label Text="{Binding SelectedPublication.PubCondition}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="20">
                    <Label Text="Lieu :" FontAttributes="Bold" />
                    <Label Text="{Binding SelectedPublication.PubLocation}" />
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5" />

                <Label Text="Description :"  FontAttributes="Bold" />
                <Label Text="{Binding SelectedPublication.PubDescription}" FontSize="14" />

                <Border Stroke="#EEEEEE" 
                        StrokeThickness="1" 
                        BackgroundColor="#F9F9F9" 
                        Margin="0,15,0,0" 
                        Padding="15">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Informations Donneur" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16" />
                        <Label Text="{Binding SelectedPublication.DonorName}" HorizontalOptions="Center" TextColor="Gray" />

                        <Button Text="Envoyer un Email" 
                                Command="{Binding ContactEmailCommand}"
                                BackgroundColor="#008F39" 
                                CornerRadius="5" />

                        <Button Text="Appeler" 
                                Command="{Binding ContactPhoneCommand}"
                                BackgroundColor="Transparent" 
                                TextColor="#008F39" 
                                BorderColor="#008F39" 
                                BorderWidth="1" 
                                CornerRadius="5" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding SelectedPublication.PubCreatedAt, StringFormat='Publié le {0:dd/MM/yyyy}'}" 
                       FontSize="11" TextColor="Gray" HorizontalOptions="Center" Margin="0,15,0,0"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>