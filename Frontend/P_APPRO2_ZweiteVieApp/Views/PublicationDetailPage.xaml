<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P_APPRO2_ZweiteVieApp.Views.PublicationDetailPage"
             Title="Détails">

    <Grid>
        <ScrollView x:Name="ContentArea" IsVisible="False">
            <VerticalStackLayout Spacing="0">

                <!-- Image + heart overlay -->
                <Grid HeightRequest="280">
                    <Image Source="{Binding PubImage}"
                           HeightRequest="280"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"/>
                    <Frame CornerRadius="22" HeightRequest="44" WidthRequest="44"
                           HorizontalOptions="End" VerticalOptions="End"
                           Margin="0,0,16,16"
                           BorderColor="#008F39"
                           BackgroundColor="White"
                           Padding="0" IsClippedToBounds="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleFavoriteTapped"/>
                        </Frame.GestureRecognizers>
                        <Grid>
                            <Label x:Name="HeartEmpty" Text="♡"
                                   FontSize="22" TextColor="#008F39"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Label x:Name="HeartFilled" Text="♥"
                                   IsVisible="False"
                                   FontSize="22" TextColor="#008F39"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </Grid>

                <VerticalStackLayout Padding="20" Spacing="12">

                    <Label x:Name="TitleLabel"
                           Text="{Binding PubTitle}"
                           FontSize="22" FontAttributes="Bold" />

                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding CatName}"
                               FontSize="13" TextColor="#008F39"
                               BackgroundColor="#E8F5E9"
                               Padding="6,2" />
                        <Label Text="{Binding ConName}"
                               FontSize="13" TextColor="#555"
                               BackgroundColor="#F5F5F5"
                               Padding="6,2" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="6">
                        <Label Text="📍" FontSize="14" />
                        <Label Text="{Binding PubLocation}"
                               FontSize="14" TextColor="Gray" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5" />

                    <Label Text="Description" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding PubDescription, TargetNullValue='Aucune description disponible.', FallbackValue='Aucune description disponible.'}"
                           FontSize="14" TextColor="#333" />

                    <Border Stroke="#EEEEEE"
                            StrokeThickness="1"
                            BackgroundColor="#F9F9F9"
                            Margin="0,15,0,0"
                            Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="Informations Donneur"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   FontSize="16" />
                            <Label Text="{Binding DonorName}"
                                   HorizontalOptions="Center"
                                   TextColor="Gray" />

                            <Button Text="✉  Envoyer un Email"
                                    Clicked="OnEmailClicked"
                                    BackgroundColor="#008F39"
                                    TextColor="White"
                                    CornerRadius="8" />

                            <Button Text="📞  Appeler"
                                    Clicked="OnPhoneClicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#008F39"
                                    BorderColor="#008F39"
                                    BorderWidth="1"
                                    CornerRadius="8" />

                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding PubCreatedAt, StringFormat='Publié le {0:dd/MM/yyyy}'}"
                           FontSize="11" TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,15,0,10"/>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="LoadingIndicator"
                           IsRunning="True"
                           IsVisible="True"
                           Color="#008F39"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
    </Grid>
</ContentPage>
